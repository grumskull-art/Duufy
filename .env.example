SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
DUUFY_INVITE_FROM_EMAIL=
DUUFY_PUBLIC_APP_URL=

FIREBASE_CRED_PATH=serviceAccount.json

# Storage backend for groups
# - json (default) uses local file: ./data/groups.json
# - supabase uses Supabase PostgreSQL (requires SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY)
# - firestore requires google-cloud-firestore (and credentials)
DUUFY_STORAGE=json
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000,capacitor://localhost,ionic://localhost

# Backwards compatibility (optional): if set to false, it implies DUUFY_STORAGE=firestore
USE_LOCAL_JSON=true

# SÅDAN SÆTTER DU FIREBASE OP:
# 1. Gå til https://console.firebase.google.com
# 2. Vælg dit projekt
# 3. Gå til Project Settings (tandhjul øverst)
# 4. Fanen "Service Accounts"
# 5. Klik "Generate new private key"
# 6. Gem JSON-filen som "serviceAccount.json" i denne mappe
# 7. Genstart serveren
