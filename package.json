{
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.80",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.3.1"
  },
  "scripts": {
    "setup:py": "python3 -m venv .venv && . .venv/bin/activate && pip install --upgrade pip && pip install -r requirements.txt",
    "start": "bash -lc '. .venv/bin/activate && uvicorn main:app --reload --host 0.0.0.0 --port 8000'",
    "test": "bash -lc '. .venv/bin/activate && pytest'",
    "build": "vite build",
    "serve": "vite preview"
  }
}
